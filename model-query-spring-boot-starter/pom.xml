<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.rey5137</groupId>
        <artifactId>model-query-parent</artifactId>
        <version>0.6.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>model-query-spring-boot-starter</artifactId>
    <name>Model Query Spring Boot Starter</name>
    <description>Spring Boot auto-configuration for Model Query</description>

    <dependencies>
        <dependency>
            <groupId>io.github.rey5137</groupId>
            <artifactId>model-query-spring-data</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.rey5137</groupId>
            <artifactId>model-query-hibernate</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Hibernate is Spring Boot's default JPA provider; the one starter brings Spring Data JPA, Hibernate and
             Boot's auto-configuration (D-97) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>
    </dependencies>
</project>

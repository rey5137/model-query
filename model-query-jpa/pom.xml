<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.rey5137</groupId>
        <artifactId>model-query-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>model-query-jpa</artifactId>
    <name>Model Query JPA</name>
    <description>Query executor, paging and export engine and built-in vendor profiles for plain JPA</description>

    <dependencies>
        <dependency>
            <groupId>io.github.rey5137</groupId>
            <artifactId>model-query-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Only @ValidChanges and its validator use it; without it nothing is validated (api/14 R-WRT-22). -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>${jakarta-validation.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>${hibernate.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
            <version>${hibernate-validator.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-el</artifactId>
            <version>${tomcat-embed-el.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <!-- AC-REL-03, configured in the root pluginManagement -->
                    <execution>
                        <id>no-hibernate-or-spring</id>
                        <phase>validate</phase>
                    </execution>
                </executions>
            </plugin>
            <!-- AC-QA-04 (R-QA-10): mutation testing of the keyset predicate builder. Not bound to a phase, so the
                 normal build stays fast; CI runs org.pitest:pitest-maven:mutationCoverage (job "mutation"). -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <configuration>
                    <skip>false</skip>
                    <targetClasses>
                        <param>com.rey.modelquery.jpa.Keyset*</param>
                    </targetClasses>
                    <excludedClasses>
                        <param>com.rey.modelquery.jpa.KeysetWrite*</param>
                    </excludedClasses>
                    <targetTests>
                        <param>com.rey.modelquery.jpa.*Test</param>
                    </targetTests>
                    <mutationThreshold>100</mutationThreshold>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

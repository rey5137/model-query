<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.rey5137</groupId>
        <artifactId>model-query-parent</artifactId>
        <version>0.4.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>model-query-test</artifactId>
    <name>Model Query Test</name>
    <description>Assertions on the filters, order and selection of a built query, with no database (D-98)</description>

    <dependencies>
        <dependency>
            <groupId>io.github.rey5137</groupId>
            <artifactId>model-query-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Compile scope: QueryAssert extends AssertJ's AbstractAssert, so users get it from here (INV-7). -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>compile</scope>
        </dependency>
        <!-- Test scope: the executor interface a unit test captures a query from (AC-INS-05). It brings no
             persistence provider; the tests run with none on the classpath. -->
        <dependency>
            <groupId>io.github.rey5137</groupId>
            <artifactId>model-query-jpa</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <!-- AC-REL-03, configured in the root pluginManagement -->
                    <execution>
                        <id>no-hibernate-or-spring</id>
                        <phase>validate</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

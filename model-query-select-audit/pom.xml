<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.rey5137</groupId>
        <artifactId>model-query-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>model-query-select-audit</artifactId>
    <name>Model Query Select Audit</name>
    <description>Select audit agent and observer: call-site capture, tagging, unselected-read detection (RFC 0026,
        D-228..D-232). Add it in test scope.</description>

    <properties>
        <audit.mockito.version>5.23.0</audit.mockito.version>
        <audit.jar>${project.build.directory}/${project.build.finalName}.jar</audit.jar>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.rey5137</groupId>
            <artifactId>model-query-jpa</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
            <version>${byte-buddy.version}</version>
        </dependency>
        <dependency>
            <!-- shaded with byte-buddy: attaches the agent when a JUnit session opens without one (D-265) -->
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy-agent</artifactId>
            <version>${byte-buddy.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>${junit.version}</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${audit.mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jacoco</groupId>
            <artifactId>org.jacoco.agent</artifactId>
            <version>0.8.16</version>
            <classifier>runtime</classifier>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.module</groupId>
            <artifactId>jackson-module-blackbird</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.module</groupId>
            <artifactId>jackson-module-afterburner</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>3.0.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <version>${jakarta-persistence.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>${hibernate.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.rey5137</groupId>
            <artifactId>model-query-processor</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>agent-dependency-paths</id>
                        <goals><goal>properties</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <proc>full</proc>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce</id>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes><exclude>org.projectlombok:*</exclude></excludes>
                                    <includes><include>org.projectlombok:lombok:*:*:test</include></includes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <id>no-hibernate-or-spring</id>
                        <phase>validate</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Premain-Class>com.rey.modelquery.audit.AuditAgent</Premain-Class>
                            <Agent-Class>com.rey.modelquery.audit.AuditAgent</Agent-Class>
                            <Can-Retransform-Classes>true</Can-Retransform-Classes>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <artifactSet>
                                <includes>
                                    <include>net.bytebuddy:byte-buddy</include>
                                    <include>net.bytebuddy:byte-buddy-agent</include>
                                </includes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>net.bytebuddy</pattern>
                                    <shadedPattern>com.rey.modelquery.audit.shaded.bytebuddy</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>net.bytebuddy:byte-buddy</artifact>
                                    <excludes>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <!-- else the agent jar reads as module net.bytebuddy on a module path -->
                                        <exclude>META-INF/versions/9/module-info.class</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>net.bytebuddy:byte-buddy-agent</artifact>
                                    <excludes>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/LICENSE</exclude>
                                        <exclude>META-INF/NOTICE</exclude>
                                        <exclude>META-INF/versions/9/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer
                                implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <argLine>
                                -javaagent:${audit.jar} -javaagent:${org.mockito:mockito-core:jar}
                            </argLine>
                            <includes>
                                <include>**/*Test.java</include>
                            </includes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jacoco-before-audit</id>
                        <goals><goal>integration-test</goal><goal>verify</goal></goals>
                        <configuration>
                            <test>AcIns18InstrumentationTest</test>
                            <argLine>
                                -javaagent:${org.jacoco:org.jacoco.agent:jar:runtime}=output=none
                                -javaagent:${audit.jar} -javaagent:${org.mockito:mockito-core:jar}
                            </argLine>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jacoco-after-audit</id>
                        <goals><goal>integration-test</goal><goal>verify</goal></goals>
                        <configuration>
                            <test>AcIns18InstrumentationTest</test>
                            <argLine>
                                -javaagent:${audit.jar}
                                -javaagent:${org.jacoco:org.jacoco.agent:jar:runtime}=output=none
                                -javaagent:${org.mockito:mockito-core:jar}
                            </argLine>
                        </configuration>
                    </execution>
                    <!-- No -javaagent below: the session attaches the agent itself, or follows missingAgent (D-265). -->
                    <execution>
                        <id>self-attach</id>
                        <goals><goal>integration-test</goal><goal>verify</goal></goals>
                        <configuration>
                            <test>SelfAttachRun</test>
                            <classesDirectory>${audit.jar}</classesDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>self-attach-in-process</id>
                        <goals><goal>integration-test</goal><goal>verify</goal></goals>
                        <configuration>
                            <test>SelfAttachRun</test>
                            <classesDirectory>${audit.jar}</classesDirectory>
                            <argLine>-Djdk.attach.allowAttachSelf=true</argLine>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- attach=auto fails (classes not from a jar), so missingAgent=warn decides -->
                        <id>failed-attach-warn</id>
                        <goals><goal>integration-test</goal><goal>verify</goal></goals>
                        <configuration>
                            <test>MissingAgentWarnRun</test>
                            <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                            <systemPropertyVariables>
                                <modelquery.selectAudit.missingAgent>warn</modelquery.selectAudit.missingAgent>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                    <execution>
                        <id>missing-agent-warn</id>
                        <goals><goal>integration-test</goal><goal>verify</goal></goals>
                        <configuration>
                            <test>MissingAgentWarnRun</test>
                            <classesDirectory>${audit.jar}</classesDirectory>
                            <systemPropertyVariables>
                                <modelquery.selectAudit.attach>startup</modelquery.selectAudit.attach>
                                <modelquery.selectAudit.missingAgent>warn</modelquery.selectAudit.missingAgent>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                    <execution>
                        <id>missing-agent-off</id>
                        <goals><goal>integration-test</goal><goal>verify</goal></goals>
                        <configuration>
                            <test>MissingAgentOffRun</test>
                            <classesDirectory>${audit.jar}</classesDirectory>
                            <systemPropertyVariables>
                                <modelquery.selectAudit.missingAgent>off</modelquery.selectAudit.missingAgent>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
